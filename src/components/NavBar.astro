---
import Logo from "./Logo.astro";

const links = [
  { href: "/", img: "/assets/images/house-icon.svg", text: "Головна" },
  { href: "/", img: "/assets/images/document-icon.svg", text: "Послуги" },
  { href: "/", img: "/assets/images/list-icon.svg", text: "Чек-апи" },
  { href: "/", img: "/assets/images/price-icon.svg", text: "Вартість" },
  { href: "/", img: "/assets/images/doctors-icon.svg", text: "Лікарі" },
  { href: "/", img: "/assets/images/camera-icon.svg", text: "Галерея" },
  { href: "/", img: "/assets/images/phone-icon.svg", text: "Контакти" },
];
---

<div
  class="flex pt-10 pl-16 pr-24 justify-between m-auto max-w-[100rem] text-tiffany select-none"
>
  <Logo />
  <div class="flex justify-end items-start gap-3 pt-1">
    {
      links.map((link) => (
        <a
          class="flex gap-[6px] px-5 py-2 items-center hover:shadow-[0px_0px_5px_5px] hover:shadow-tiffany outline outline-[3px] hover:outline-offset-0 outline-offset-2 outline-tiffany/0 hover:outline-tiffany rounded-xl transition-all duration-300 ease-in-out"
          href={link.href}
        >
          <img class="w-5 h-5" src={link.img} alt={link.text} />
          <span class="font-medium leading-none">{link.text}</span>
        </a>
      ))
    }
  </div>
</div>
