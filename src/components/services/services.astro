---
import ClinicViewImg from '@/assets/images/services-clinic-view.jpeg';
import HeartMockupImg from '@/assets/images/services-heart-mockup.jpeg';
import Circle from '@/assets/images/services-circle-icon.svg';

const serviceItemData = [
  {
    title: 'УЗД діагностика',
    text: `УЗД - це безпечний, неінвазивний метод дослідження,
          який дозволяє отримати детальні зображення внутрішніх
          органів та тканин за допомогою високочастотних звукових хвиль.
          В нашій клініці проводиться широкий перелік УЗД обстежень, як дорослим так і дітям. Ми 
          використовуємо передові методи та сучасне обладнання для отримання точних результатів, 
          необхідних для правильного діагностування та лікування. УЗД діагностика проводиться на 
          Сучасному апараті УЗД Phillips.`,
  },
  {
    title: 'Консультації',
    text: `Наші досвідчені лікарі надають індивідуальні поради 
          та розробляють персоналізовані плани лікування, щоб забезпечити найкращий результат 
          для кожного пацієнта.`,
  },
  {
    title: 'Аналізи',
    text: `Разом з нашими партнерами - лабораторією ProLab, ми 
          забезпечуємо нашим пацієнтам швидку та надійну лабораторну діагностику.`,
  },
];

const servicesDescription = `Ми знаходимо індивідуальний підхід до кожного пацієнта, забезпечуючи
                                    комплексне обстеження та ефективне лікування за допомогою сучасного 
                                    обладнання та методів доказової медицини. Наша цінність - кращі лікарі, 
                                    які є професіоналами у своїй галузі, весь час навчаються, оновлюють знання 
                                    та підвищують свою кваліфікацію.`;
---

<>
  <div class='container mx-auto px-[1.2rem]'>
    <div class='flex flex-col'>
      <div
        class='mx-auto h-[23.375rem] w-full overflow-hidden lg:h-[33.75rem] lg:w-full'
      >
        <img
          class='h-full w-full object-cover'
          src={ClinicViewImg.src}
          alt=''
        />
      </div>
      <div
        class='flex flex-col xl:grid xl:grid-cols-3 xl:grid-rows-1 xl:gap-[1.88rem]'
      >
        <div class='pt-[2.5rem]'>
          <div class='text-[1.75rem] font-semibold text-tiffany-light'>
            {serviceItemData[0].title}
          </div>
          <div class='pt-[1.9rem] font-medium text-[#444]'>
            {serviceItemData[0].text}
          </div>
        </div>
        <div class='pt-[2.5rem]'>
          <div class='text-[1.75rem] font-semibold text-tiffany-light'>
            {serviceItemData[1].title}
          </div>
          <div class='pt-[1.9rem] font-medium text-[#444]'>
            {serviceItemData[1].text}
          </div>
        </div>
        <div class='pt-[2.5rem]'>
          <div class='text-[1.75rem] font-semibold text-tiffany-light'>
            {serviceItemData[2].title}
          </div>
          <div class='pt-[1.9rem] font-medium text-[#444]'>
            {serviceItemData[2].text}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class='container mx-auto px-[1.2rem] py-[7rem]'>
    <div
      class='pb-[1.69rem] text-[1.875rem] font-semibold tracking-[0.09375rem] text-tiffany-light'
    >
      Послуги
    </div>
    <p class='max-w-[47.125rem] pb-[2.5rem] font-medium text-[#444]'>
      {servicesDescription}
    </p>
    <div class='flex flex-col gap-[1.88rem] xl:flex-row xl:items-center'>
      <div class='h-[23.375rem] xl:h-[21.25rem] xl:grow'>
        <img
          class='h-full w-full object-cover'
          src={HeartMockupImg.src}
          alt=''
        />
      </div>
      <div
        class='flex flex-col gap-[1.88rem] pt-[1.88rem] text-[0.75rem] font-semibold xl:pt-0'
      >
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>загальноклінічні дослідження</div>
        </div>
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>функціональна діагностика</div>
        </div>
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>УЗД діагностика</div>
        </div>
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>консультації спеціалістів</div>
        </div>
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>онкологічна панель</div>
        </div>
        <div class='flex items-center'>
          <img class='object-cover' src={Circle.src} alt='' />
          <div class='pl-[0.94rem]'>маркери анемії, вітаміни</div>
        </div>
      </div>
    </div>
  </div>
</>
