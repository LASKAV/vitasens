---
import { menuItems } from './navBar/navBar';
import clockFilledIcon from '@/assets/images/clock-filled-icon.svg';
import envelopeFilledIcon from '@/assets/images/envelope-filled-icon.svg';
import phoneFilledIcon from '@/assets/images/phone-filled-icon.svg';
import LogoImg from '@/assets/images/logo-high-res.jpeg';
import { type SocialMedia } from '@/types/SocialMedia';
import fetchApi from '@/lib/strapi';
import { RegisteredNurse } from '@/types/RegisteredNurse';

type DoctorLinkType = {
  name: string;
  href: string;
};

let socialMedias;
let registeredNurses;

try {
  socialMedias = await fetchApi<SocialMedia[]>({
    endpoint: 'social-medias',
    wrappedByKey: 'data',
    query: {
      'sort[id]': 'asc',
    },
  });
} catch (e) {
  console.error(e);
}

try {
  registeredNurses = await fetchApi<RegisteredNurse[]>({
    endpoint: 'doctors',
    wrappedByKey: 'data',
    query: {
      'sort[id]': 'asc',
    },
  });
} catch (e) {
  console.error(e);
}

const registeredNurseLinks: DoctorLinkType[] = registeredNurses?.map(item => {
  return {
    name: `${item.firstName} ${item.lastName}`,
    href: '/doctors?id=' + item.id,
  };
});

const currentYear = new Date().getFullYear();
---

<div class='mx-auto max-w-[100rem] pb-[2.56rem] xl:pb-[1.56rem]'>
  <div
    class='flex flex-col justify-center gap-7 bg-[#020202]/70 py-10 text-xs leading-normal tracking-[0.6px] text-white xl:flex-row'
  >
    <div class='order-2 flex flex-col items-center gap-3 xl:order-1'>
      <img class='h-5 w-5' src={phoneFilledIcon.src} alt='Телефон' />
      <div>
        +38<span class='text-[#0FF]'>093</span> 432 00 22 <br /> +38<span
          class='text-[#0FF]'>096</span
        > 432 00 22
      </div>
    </div>
    <div class='order-3 flex flex-col items-center gap-3 xl:order-2'>
      <img class='h-5 w-5' src={envelopeFilledIcon.src} alt='Пошта' />
      <div>klinikavitasens@gmail.com</div>
    </div>
    <div class='order-1 flex flex-col items-center gap-3 xl:order-3'>
      <img class='h-5 w-5' src={clockFilledIcon.src} alt='Графік роботи' />
      <div class='text-center'>
        Понеділок - пʼятниця: <br />&nbsp;&nbsp;&nbsp;&nbsp;9:00 - 18:00
      </div>
    </div>
  </div>
  <div
    class='pb-7 pt-5 text-center text-[0.8125rem] font-medium leading-normal tracking-[0.8px] text-[#444] xl:text-[1rem]'
  >
    адреса: м. Одеса, вул. Сонячна 4, ЖК “Сонячний”
  </div>
  <div class='mx-auto flex w-full flex-col gap-4 xl:w-[1240px]'>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1374.794547172635!2d30.75125318197134!3d46.437023465893596!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40c6339296243e51%3A0xcc68c288f2ab6aa1!2sSonyachna%20St%2C%204%2C%20Odesa%2C%20Odes'ka%20oblast%2C%2065000!5e0!3m2!1sen!2sua!4v1713203557262!5m2!1sen!2sua"
      width='100%'
      height='220'
      class='self-center rounded-[40px]'
      style='border:0;'
      allowfullscreen=''
      loading='lazy'
      referrerpolicy='no-referrer-when-downgrade'></iframe>
  </div>
  <div
    class='container mx-auto flex flex-wrap gap-[1.5rem] pb-[8.7rem] pl-7 pt-[1.88rem] tracking-[0.04375rem] lg:justify-between xl:max-w-[1240px]'
  >
    <div>
      <div class='font-medium text-[#444]'>Навігація</div>
      {
        menuItems.map(menuItem => (
          <div class='pl-5 pt-[1.88rem] text-[0.875rem] text-[#B6B6B6] xl:text-[1rem]'>
            <a href={menuItem.href}>{menuItem.title}</a>
            {menuItem.submenu &&
              menuItem.submenu.map(submenuItem => (
                <div class='pl-5 pt-[0.31rem]'>
                  <a href={submenuItem.href}>{submenuItem.title}</a>
                </div>
              ))}
          </div>
        ))
      }
    </div>
    <div class='flex flex-col gap-[1.5rem] md:flex-row xl:gap-[5rem]'>
      <div class='pb-6'>
        <div class='font-medium text-[#444]'>Соціальні мережі</div>
        {
          socialMedias?.map(socialMedia => (
            <div class='pl-5 pt-[1.88rem] text-[0.875rem] text-[#B6B6B6] xl:text-[1rem]'>
              <a
                href={socialMedia.link ? socialMedia.link : '/'}
                target='_blank'
              >
                {socialMedia.title}
              </a>
            </div>
          ))
        }
      </div>
      <div>
        <div class='font-medium text-[#444]'>Лікарі</div>
        {
          registeredNurseLinks?.map(rnLink => (
            <div class='pl-5 pt-[1.88rem] text-[0.875rem] text-[#B6B6B6] xl:text-[1rem]'>
              <a href={rnLink.href}>{rnLink.name}</a>
            </div>
          ))
        }
      </div>
    </div>
    <div>
      <div class='font-medium text-[#444]'>NDA</div>
      <div
        class='pl-5 pt-[1.88rem] text-[0.875rem] text-[#B6B6B6] xl:text-[1rem]'
      >
        <a href='/'>Політика конфіденційності</a>
      </div>
    </div>
    <div class='hidden h-[5rem] w-[5rem] self-end lg:block'>
      <img class='h-full w-full object-cover' src={LogoImg.src} alt='' />
    </div>
  </div>
  <div class='text-center font-light tracking-[0.05rem] text-[#444]'>
    {currentYear} © Всі права захищені VitaSens.com
  </div>
</div>
