---
import { menuItems } from './navBar/navBar';
import clockFilledIcon from '@/assets/images/clock-filled-icon.svg';
import envelopeFilledIcon from '@/assets/images/envelope-filled-icon.svg';
import phoneFilledIcon from '@/assets/images/phone-filled-icon.svg';
import LogoImg from 'public/assets/images/logo-high-res.jpeg';

const socialMediaLinks = [
  {
    title: 'Instagram',
    href: '/',
  },
  {
    title: 'Facebook',
    href: '/',
  },
  {
    title: 'Telegram',
    href: '/'
  }
]

const registeredNurseLinks = [
  {
    name: 'Саморукова Вікторія',
    href: '/',
  },
  {
    name: 'Дукова Ольга',
    href: '/',
  },
  {
    name: 'Хоміна Ольга',
    href: '/',
  },
  {
    name: 'Гвоздяниця Анастасія',
    href: '/',
  },
  {
    name: 'Кудінова Наталія',
    href: '/',
  },
]

const currentYear = new Date().getFullYear();

---

<div class='mx-auto max-w-[100rem] pb-[10rem] xl:pb-[1.56rem]'>
  <div
    class='flex flex-col xl:flex-row justify-center gap-7 bg-[#020202]/70 py-10 text-xs leading-normal tracking-[0.6px] text-white'
  >
    <div class='flex flex-col items-center gap-3 order-2 xl:order-1'>
      <img class='h-5 w-5' src={phoneFilledIcon.src} alt='Телефон' />
        <div>+38<span class="text-[#0FF]">093</span> 432 00 22 <br /> +38<span class="text-[#0FF]">096</span> 432 00 22</div>
    </div>
    <div class='flex flex-col items-center gap-3 order-3 xl:order-2'>
      <img class='h-5 w-5' src={envelopeFilledIcon.src} alt='Пошта' />
      <div>klinikavitasens@gmail.com</div>
    </div>
    <div class='flex flex-col items-center gap-3 order-1 xl:order-3'>
      <img class='h-5 w-5' src={clockFilledIcon.src} alt='Графік роботи' />
      <div class='text-center'>Понеділок - пʼятниця: <br />&nbsp;&nbsp;&nbsp;&nbsp;9:00 - 18:00</div>
    </div>
  </div>
  <div
    class='text-[0.8125rem] xl:text-[1rem] pb-7 pt-5 text-center font-medium leading-normal tracking-[0.8px] text-[#444]'
  >
    адреса: м. Одеса, вул. Сонячна 4, ЖК “Сонячний”
  </div>
  <div class='mx-auto flex w-full xl:w-[1240px] flex-col gap-4'>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1374.794547172635!2d30.75125318197134!3d46.437023465893596!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40c6339296243e51%3A0xcc68c288f2ab6aa1!2sSonyachna%20St%2C%204%2C%20Odesa%2C%20Odes'ka%20oblast%2C%2065000!5e0!3m2!1sen!2sua!4v1713203557262!5m2!1sen!2sua"
      width='100%'
      height='220'
      class='self-center rounded-[40px]'
      style='border:0;'
      allowfullscreen=''
      loading='lazy'
      referrerpolicy='no-referrer-when-downgrade'></iframe>
  </div>
    <div class="container mx-auto pt-[1.88rem] pb-[8.7rem] pl-7 flex flex-wrap gap-[1.5rem] tracking-[0.04375rem] xl:max-w-[1240px] lg:justify-between">
      <div>
        <div class="text-[#444] font-medium">Навігація</div>
        {
          menuItems.map(menuItem => (
            <div class="pl-5 pt-[1.88rem] text-[#B6B6B6] text-[0.875rem] xl:text-[1rem]">
                <a href={menuItem.href} onclick={menuItem.action}>{menuItem.title}</a>
                {
                  menuItem.submenu && menuItem.submenu.map(submenuItem => (
                    <div class="pl-5 pt-[0.31rem]">
                        <a href={submenuItem.href}>{submenuItem.title}</a>
                    </div>
                  ))
                }
            </div>
          ))
        }
      </div>
      <div class="flex flex-col gap-[1.5rem] md:flex-row xl:gap-[5rem]">
        <div class="pb-6">
          <div class="text-[#444] font-medium">Соціальні мережі</div>
          {
            socialMediaLinks.map(socialMedia => (
              <div class="pl-5 pt-[1.88rem] text-[#B6B6B6] text-[0.875rem] xl:text-[1rem]">
                <a href={socialMedia.href}>{socialMedia.title}</a>
              </div>
            ))
          }
        </div>
        <div>
          <div class="text-[#444] font-medium">Лікарі</div>
          {
            registeredNurseLinks.map(rnLink => (
              <div class="pl-5 pt-[1.88rem] text-[#B6B6B6] text-[0.875rem] xl:text-[1rem]">
                <a href={rnLink.href}>{rnLink.name}</a>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <div class="text-[#444] font-medium">NDA</div>
        <div class="pl-5 pt-[1.88rem] text-[#B6B6B6] text-[0.875rem] xl:text-[1rem]">
          <a href="/">Політика конфіденційності</a>
        </div>
      </div>
      <div class="hidden lg:block w-[5rem] h-[5rem] self-end">
          <img class="object-cover w-full h-full" src={LogoImg.src} alt="" />
      </div>
    </div>
    <div class="text-[#444] text-center font-light tracking-[0.05rem]">
      {currentYear} © Всі права захищені VitaSens.com
    </div>
</div>
