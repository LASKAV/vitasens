---
import '@fontsource-variable/montserrat';
import '@/assets/styles/main.css';
import Favicon from '@/assets/images/favicon.svg';
import NavBar from '@/components/navBar/navBar';
import fetchApi from '@/lib/strapi';
import { type Appointment } from '../types/Appointment';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const pathname = new URL(Astro.request.url).pathname;

let defaultAppointmentId: number = import.meta.env.DEFAULT_APPOINTMENT_ID;
let appointment;
try {
  appointment = await fetchApi<Appointment>({
    endpoint: 'appointments/' + defaultAppointmentId,
    wrappedByKey: 'data',
  });
} catch (e) {
  console.error(e);
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Клініка доктора Саморукової' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href={Favicon.src} />
    <meta name='generator' content={Astro.generator} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap'
      rel='stylesheet'
    />
    <title>{title}</title>
  </head>
  <body class='font-montserrat'>
    <NavBar
      currentPage={pathname}
      serviceId={appointment?.id}
      service={appointment?.name}
      client:only='solid-js'
    />

    <main>
      <slot />
    </main>

    <footer>
      <Footer />
    </footer>
  </body>
</html>
