---
import MainLayout from '../layouts/MainLayout.astro';
import { marked } from 'marked';
import fetchApi from '../lib/strapi';

let policy;
let content;

try {
  policy = await fetchApi<any>({
    endpoint: 'privacy-policy',
    wrappedByKey: 'data',
  });
  content = marked.parse(policy.Content, {
    gfm: true,
    breaks: true,
  });
} catch (e) {
  console.error('err', e);
}
---

<MainLayout title='Політика конфіденційності'>
  <div class='container mx-auto px-4 pb-[7rem] lg:px-0'>
    <h1 class='py-12 text-[1.5rem] text-tiffany-light lg:text-[2.5rem]'>
      {policy.Title}
    </h1>

    <Fragment set:html={content} />
  </div>
</MainLayout>
