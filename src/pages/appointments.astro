---
import fetchApi from '../lib/strapi';
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
import AppointmentBookList from '@/components/appointmentsToBookList/appointmentsToBookList';
import AppointmentImg from '@/assets/images/service-appointments.jpg';
import AppointmentDeskImg from '@/assets/images/service-appointments-desk.jpg';
import { type Appointment } from '@/types/Appointment';

const appointmentsDescription =
  'Наші досвідчені лікарі надають індивідуальні поради та розробляють ' +
  'персоналізовані плани лікування, щоб забезпечити найкращий результат ' +
  'для кожного пацієнта.';

let appointments;

try {
  appointments = await fetchApi<Appointment[]>({
    endpoint: 'appointments',
    wrappedByKey: 'data',
    query: {
      'sort[id]': 'asc',
    },
  });
} catch (e) {
  console.error('err', e);
}
---

<SecondaryLayout title='Консультації'>
  <div
    class='mx-auto max-w-[80rem] px-5 pb-[9rem] pt-[3.44rem] lg:grid lg:grid-cols-6 lg:grid-rows-2 lg:px-0'
  >
    <div
      class='flex flex-col items-end lg:col-span-2 lg:col-start-5 lg:row-span-2'
    >
      <div
        class='pb-5 text-right text-[1.875rem] font-semibold text-tiffany-light'
      >
        Консультації
      </div>
      <p
        class='max-w-[24.56rem] pb-[1.88rem] text-right text-[#929292] lg:pb-[6rem]'
      >
        {appointmentsDescription}
      </p>
      <div
        class='align-self-start col-span-2 col-start-4 row-start-2 hidden h-[20rem] w-[21.875rem] justify-self-end lg:block'
      >
        <img
          class='h-full w-full object-cover drop-shadow-[5px_-5px_0px_rgba(70,208,208,1)]'
          src={AppointmentDeskImg.src}
          alt=''
        />
      </div>
    </div>
    <div
      class='h-[32.5rem] max-w-[31.4375rem] lg:col-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:h-[43.75rem]'
    >
      <img
        class='h-full w-full object-cover drop-shadow-[-8px_8px_0px_rgba(70,208,208,1)]'
        src={AppointmentImg.src}
        alt=''
      />
    </div>
    <div
      class='pt-[3.75rem] lg:col-span-2 lg:row-start-2 lg:self-start lg:pl-[3.2rem] lg:pt-0'
    >
      <div class='pb-[2.5rem] text-[1.25rem] font-semibold text-tiffany-light'>
        Консультації лікарів
      </div>
      <div class='flex flex-col gap-4 pb-[2.5rem] font-medium'>
        <AppointmentBookList
          appointments={appointments}
          referrerUrl={Astro.url.href}
          client:only='solid-js'
        />
      </div>
      <a href='/prices?open=appointments'>
        <button
          class='rounded-[0.625rem] bg-tiffany-light px-[4rem] py-[1rem] text-[1.25rem] text-white'
        >
          Детальніше
        </button>
      </a>
    </div>
  </div>
</SecondaryLayout>
