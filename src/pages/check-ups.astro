---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
import CheckUpSlider from '../components/checkUpSlider/checkUpSlider';
import type { CheckUp } from '@/types/CheckUp.ts';
import fetchApi from '../lib/strapi';

import Star1 from '@/assets/images/background-rect-checkups-star1.svg';
import Star2 from '@/assets/images/background-rect-checkups-star2.svg';

let checkups;

try {
  checkups = await fetchApi<CheckUp[]>({
    endpoint: 'checkups',
    wrappedByKey: 'data',
  });
} catch (e) {
  console.error('err', e);
}
---

<SecondaryLayout title='Чек-апи'>
  <div class='h-[8.5rem]'></div>
  <CheckUpSlider
    checkUps={checkups}
    referrerUrl={Astro.url.href}
    client:only='solid-js'
  />
  <img
    class='absolute right-0 top-[13rem] h-[7.5rem] w-[3.5rem] lg:h-[15rem] lg:w-[8rem]'
    src={Star2.src}
    alt=''
  />
  <img
    class='absolute bottom-0 h-[7.5rem] w-[3.5rem] lg:h-[15rem] lg:w-[8rem]'
    src={Star1.src}
    alt=''
  />
</SecondaryLayout>
