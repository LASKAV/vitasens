---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
import NavBar from '../components/navBar/navBar';
import CheckUpSlider from '../components/checkUpSlider/checkUpSlider';

import Star1 from '@/assets/images/background-rect-checkups-star1.svg';
import Star2 from '@/assets/images/background-rect-checkups-star2.svg';
---


<SecondaryLayout title="Чек-апи">

    <NavBar slot="header" />
    <div class="flex justify-center pt-[2.25rem] pb-[2.56rem] lg:pb-[4.5rem]">
        <p class="px-[2.9rem] py-[2.41rem] bg-tiffany-light/20 font-semibold text-tiffany-light text-[2.5rem] rounded-full w-fit">Чек-апи</p>
    </div>
    <CheckUpSlider client:only="solid-js" />
    <img class="absolute right-0 top-[13rem] w-[3.5rem] h-[7.5rem] lg:w-[8rem] lg:h-[15rem]" src={Star2.src} alt="" />
    <img class="absolute bottom-0 w-[3.5rem] h-[7.5rem] lg:w-[8rem] lg:h-[15rem]" src={Star1.src} alt="" />
</SecondaryLayout>
